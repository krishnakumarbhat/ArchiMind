# ArchiMind Environment Configuration
# ====================================

# Required: Flask secret key for sessions/cookies
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_secret

# Required for Gemini-powered documentation generation
GEMINI_API_KEY=replace_with_gemini_api_key
DOCUMENTATION_MODEL=gemini-3.1-flash-lite-preview
CHAT_MODEL=gemini-3.1-flash-lite-preview
GEMINI_THINKING_LEVEL=high
GEMINI_API_VERSION=v1alpha
DOCUMENTATION_CONTEXT_CHAR_LIMIT=36000

# Vector store
VECTOR_BACKEND=pinecone
EMBEDDING_MODEL=models/text-embedding-004
PINECONE_API_KEY=replace_with_pinecone_api_key
PINECONE_INDEX_NAME=archimind
PINECONE_NAMESPACE=prod
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=768

# Database URL
# Render / Supabase production example:
# DATABASE_URL=postgresql+psycopg://postgres:password@db.example.supabase.co:5432/postgres
# Local fallback:
DATABASE_URL=sqlite:///data/archimind_dev.db

# Optional Flask runtime options
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
PREFERRED_URL_SCHEME=https

# Optional anonymous usage cap
ANONYMOUS_GENERATION_LIMIT=5
REQUEST_TIMEOUT_SECONDS=25
REMOTE_FETCH_MAX_FILES=120
REMOTE_FETCH_CONCURRENCY=8
REMOTE_FILE_MAX_BYTES=220000

# Optional Google OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Docker / deployment defaults
ARCHIMIND_IMAGE=krishnah27/archimind:latest
DOCKERHUB_REPO=krishnah27/archimind
DOCKER_IMAGE_TAG=latest
PI_USER=pi
PI_HOST=192.168.0.65
PI_DIR=/home/pi/archimind

# Local HTTP OAuth testing only. Use 0 in production over HTTPS.
OAUTHLIB_INSECURE_TRANSPORT=0
