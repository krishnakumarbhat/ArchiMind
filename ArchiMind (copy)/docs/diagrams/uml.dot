digraph ArchiMind_UML {
  rankdir=LR;
  graph [label="ArchiMind UML Runtime Structure", labelloc=t, fontsize=20, fontname="Inter"];
  node [shape=box, style="rounded,filled", fillcolor="#f7fbff", color="#53789c", fontname="Inter"];
  edge [color="#4a6484", fontname="Inter"];

  App [label="ArchiMindApplication\nFlask app factory\nroute registration"];
  AppConfig [label="ApplicationConfig\nsecret key\nDB URL\nlimits"];
  Worker [label="AnalysisWorker\nstatus updates\nanalysis orchestration"];
  RepoSvc [label="RepositoryService\nremote fetch\nlocal clone fallback"];
  VectorSvc [label="VectorStoreService\nsummary + chunk index\nretrieval graph"];
  DocSvc [label="DocumentationService\nGemini generation\nlocal fallback"];
  User [label="User\nauthenticated actor"];
  AnalysisLog [label="AnalysisLog\nrequest lifecycle"];
  History [label="RepositoryHistory\nstored artifacts"];

  App -> AppConfig [label="owns"];
  App -> Worker [label="launches subprocess"];
  App -> User [label="authenticates"];
  App -> AnalysisLog [label="creates / queries"];

  Worker -> RepoSvc [label="collects repository files"];
  Worker -> VectorSvc [label="indexes + retrieves context"];
  Worker -> DocSvc [label="generates docs + diagrams"];
  Worker -> AnalysisLog [label="updates status"];
  Worker -> History [label="persists user history"];

  User -> AnalysisLog [label="has many"];
  User -> History [label="has many"];
}