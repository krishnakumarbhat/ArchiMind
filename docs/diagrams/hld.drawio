<mxfile host="app.diagrams.net" modified="2026-04-05" agent="ArchiMind" version="24.7">
    <diagram name="High-Level Architecture" id="hld">
        <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="1">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;ArchiMind — High-Level Architecture&lt;/b&gt;&lt;br&gt;AI-Powered Repository Analysis Platform" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="660" y="20" width="400" height="50" as="geometry"/></mxCell>
                <mxCell id="user" value="&lt;b&gt;User / Browser&lt;/b&gt;&lt;br&gt;Submits GitHub repo URL&lt;br&gt;Views generated docs &amp; graphs" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="120" height="110" as="geometry"/></mxCell>
                <mxCell id="flask" value="&lt;b&gt;Flask Application&lt;/b&gt;&lt;br&gt;&lt;i&gt;app.py&lt;/i&gt;&lt;br&gt;• REST API: /api/analyze, /api/status, /api/chat&lt;br&gt;• Auth: login, sign-up, OAuth callback&lt;br&gt;• Security: CSP, HSTS, no-store headers&lt;br&gt;• Rate limiting (anonymous cap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="280" y="270" width="260" height="120" as="geometry"/></mxCell>
                <mxCell id="oauth" value="&lt;b&gt;Google OAuth2&lt;/b&gt;&lt;br&gt;&lt;i&gt;oauth_utils.py&lt;/i&gt;&lt;br&gt;Authlib • In-process history cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="440" width="220" height="60" as="geometry"/></mxCell>
                <mxCell id="worker" value="&lt;b&gt;Analysis Worker&lt;/b&gt;&lt;br&gt;&lt;i&gt;worker.py (subprocess)&lt;/i&gt;&lt;br&gt;Pipeline: Prepare → Ingest → Index → Retrieve → Generate&lt;br&gt;Status persistence to JSON • DB log updates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="620" y="270" width="280" height="100" as="geometry"/></mxCell>
                <mxCell id="reposvc" value="&lt;b&gt;RepositoryService&lt;/b&gt;&lt;br&gt;GitHub API tree fetch&lt;br&gt;Selective remote ingestion&lt;br&gt;GitPython clone fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="200" height="80" as="geometry"/></mxCell>
                <mxCell id="vecsvc" value="&lt;b&gt;VectorStoreService&lt;/b&gt;&lt;br&gt;AST chunking (Python) + LlamaIndex CodeSplitter&lt;br&gt;Gemini embeddings + hash fallback&lt;br&gt;LangGraph 2-step RAG retrieval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="210" width="260" height="80" as="geometry"/></mxCell>
                <mxCell id="docsvc" value="&lt;b&gt;DocumentationService&lt;/b&gt;&lt;br&gt;Gemini-powered handbook generation&lt;br&gt;HLD / LLD / Flow Mermaid diagrams&lt;br&gt;Chat Q&amp;A (RAG) • Local heuristic fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="320" width="260" height="80" as="geometry"/></mxCell>
                <mxCell id="supabase" value="&lt;b&gt;Supabase PostgreSQL&lt;/b&gt;&lt;br&gt;5NF Schema:&lt;br&gt;repositories • users • analysis_logs&lt;br&gt;repository_history • analysis_artifacts" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="200" height="120" as="geometry"/></mxCell>
                <mxCell id="pinecone" value="&lt;b&gt;Pinecone (Production)&lt;/b&gt;&lt;br&gt;Serverless vector DB&lt;br&gt;768-dim cosine index&lt;br&gt;Namespaced per-repo" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1040" y="440" width="180" height="110" as="geometry"/></mxCell>
                <mxCell id="chroma" value="&lt;b&gt;ChromaDB (Local Dev)&lt;/b&gt;&lt;br&gt;PersistentClient&lt;br&gt;data/vector_store/" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="440" width="160" height="100" as="geometry"/></mxCell>
                <mxCell id="gemini" value="&lt;b&gt;Google Gemini API&lt;/b&gt;&lt;br&gt;gemini-3.1-flash-lite-preview&lt;br&gt;Thinking config (high)&lt;br&gt;text-embedding-004" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1380" y="180" width="220" height="120" as="geometry"/></mxCell>
                <mxCell id="github" value="&lt;b&gt;GitHub API&lt;/b&gt;&lt;br&gt;/repos/.../git/trees&lt;br&gt;raw.githubusercontent.com" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1380" y="60" width="200" height="90" as="geometry"/></mxCell>
                <mxCell id="templates" value="&lt;b&gt;Jinja2 Templates&lt;/b&gt;&lt;br&gt;index • doc • login • sign_up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="160" height="60" as="geometry"/></mxCell>
                <mxCell id="static" value="&lt;b&gt;Frontend Assets&lt;/b&gt;&lt;br&gt;script.js (sessionStorage + polling)&lt;br&gt;doc.js (Mermaid + Marked + DOMPurify)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="200" height="60" as="geometry"/></mxCell>
                <mxCell id="docker" value="&lt;b&gt;Docker + Gunicorn&lt;/b&gt;&lt;br&gt;Multi-stage build • Non-root&lt;br&gt;Healthcheck • amd64+arm64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontColor=#333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="620" y="440" width="200" height="60" as="geometry"/></mxCell>
