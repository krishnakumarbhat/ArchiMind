                <mxCell value="prod" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;dashed=1;" edge="1" source="vecsvc" target="pinecone" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell value="dev" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;dashed=1;" edge="1" source="vecsvc" target="chroma" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
