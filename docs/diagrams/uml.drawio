<mxfile host="app.diagrams.net" modified="2026-04-05" agent="ArchiMind" version="24.7">
    <diagram name="UML Class Diagram" id="uml">
        <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" math="0" shadow="1">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;ArchiMind — UML Class Diagram&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="10" width="350" height="30" as="geometry"/></mxCell>
                <!-- ArchiMindApplication -->
                <mxCell id="c1" value="&lt;b&gt;ArchiMindApplication&lt;/b&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;- app: Flask&lt;br&gt;- config: ApplicationConfig&lt;br&gt;- repo_service: RepositoryService&lt;br&gt;- login_manager: LoginManager&lt;/p&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;+ _api_analyze(): Response&lt;br&gt;+ _api_status(): Response&lt;br&gt;+ _api_chat(): Response&lt;br&gt;+ _documentation(): Response&lt;br&gt;+ _login() / _sign_up()&lt;br&gt;+ run(**kwargs)&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="230" as="geometry"/></mxCell>
                <!-- AnalysisWorker -->
                <mxCell id="c2" value="&lt;b&gt;AnalysisWorker&lt;/b&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;- logger: Logger&lt;br&gt;- repo_service: RepositoryService&lt;br&gt;- status_file: str&lt;/p&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;+ run_analysis(repo_url, id)&lt;br&gt;- _update_status()&lt;br&gt;- _set_stage()&lt;br&gt;- _parse_graph_data()&lt;br&gt;- _sanitize_mermaid_code()&lt;br&gt;- _save_to_history()&lt;br&gt;- _update_database_log()&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="70" width="240" height="230" as="geometry"/></mxCell>
                <!-- RepositoryService -->
                <mxCell id="c3" value="&lt;b&gt;RepositoryService «Singleton»&lt;/b&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;- _instance: Optional[RepositoryService]&lt;br&gt;- logger: Logger&lt;/p&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;+ collect_repository_files()&lt;br&gt;+ get_repository_preview()&lt;br&gt;+ clone_repository()&lt;br&gt;+ build_collection_name()&lt;br&gt;- _fetch_remote_repository_files()&lt;br&gt;- _http_get_json/text/bytes()&lt;br&gt;- _select_remote_paths()&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="260" height="230" as="geometry"/></mxCell>
                <!-- VectorStoreService -->
                <mxCell id="c4" value="&lt;b&gt;VectorStoreService&lt;/b&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;- summary_collection / chunk_collection&lt;br&gt;- embedding_model: str&lt;br&gt;- vector_backend: str&lt;br&gt;- embedding_dimension: int&lt;/p&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;+ generate_embeddings(file_contents)&lt;br&gt;+ query_similar_documents(query)&lt;br&gt;+ reset()&lt;br&gt;+ is_empty()&lt;br&gt;- _embed_texts() / _embed_with_gemini()&lt;br&gt;- _extract_python_blocks()&lt;br&gt;- _llama_code_split()&lt;br&gt;- _make_chunk_records()&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="260" height="260" as="geometry"/></mxCell>
                <!-- DocumentationService -->
                <mxCell id="c5" value="&lt;b&gt;DocumentationService&lt;/b&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;- api_key: str&lt;br&gt;- model_name / chat_model_name: str&lt;br&gt;- thinking_level: str&lt;br&gt;- context_char_limit: int&lt;/p&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;+ generate_all_documentation()&lt;br&gt;+ generate_chat_answer()&lt;br&gt;+ generate_chat_summary()&lt;br&gt;- _generate_with_gemini()&lt;br&gt;- _build_local_hld/lld/flow()&lt;br&gt;- _build_local_documentation()&lt;br&gt;- _build_repository_profile()&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1280" y="70" width="260" height="260" as="geometry"/></mxCell>
                <!-- Models -->
                <mxCell id="c6" value="&lt;b&gt;Repository&lt;/b&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;+ id: int PK&lt;br&gt;+ url: str UNIQUE&lt;br&gt;+ name: str&lt;br&gt;+ owner: str&lt;br&gt;+ created_at: datetime&lt;/p&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;+ get_or_create(url, name, owner)&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="200" height="170" as="geometry"/></mxCell>
                <mxCell id="c7" value="&lt;b&gt;User «UserMixin»&lt;/b&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;+ id: int PK&lt;br&gt;+ email: str UNIQUE&lt;br&gt;+ password: str?&lt;br&gt;+ first_name: str&lt;br&gt;+ oauth_provider / oauth_id: str?&lt;br&gt;+ created_at: datetime&lt;/p&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;+ get_analysis_count()&lt;br&gt;+ get_recent_repositories(limit)&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="290" y="380" width="210" height="200" as="geometry"/></mxCell>
                <mxCell id="c8" value="&lt;b&gt;AnalysisLog&lt;/b&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;+ id: int PK&lt;br&gt;+ user_id: FK → users&lt;br&gt;+ session_id: str?&lt;br&gt;+ repository_id: FK → repositories&lt;br&gt;+ repo_url: str&lt;br&gt;+ status: str&lt;br&gt;+ created_at / completed_at&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="550" y="380" width="210" height="180" as="geometry"/></mxCell>
                <mxCell id="c9" value="&lt;b&gt;RepositoryHistory&lt;/b&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;+ id: int PK&lt;br&gt;+ user_id: FK → users&lt;br&gt;+ repository_id: FK → repositories&lt;br&gt;+ last_accessed / created_at&lt;br&gt;UNIQUE(user_id, repository_id)&lt;/p&gt;&lt;hr&gt;&lt;p style='text-align:left;margin:4px;font-size:9px'&gt;+ add_or_update(...)&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="810" y="380" width="220" height="180" as="geometry"/></mxCell>
