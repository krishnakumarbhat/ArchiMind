# AGENT INSTRUCTION: If you modify this project, strictly adhere to the
# single-responsibility principle, use standardized logging, and NEVER hardcode secrets.
# All secrets must come from environment variables.

# ArchiMind Environment Configuration
# ====================================

# Required: Flask secret key for sessions/cookies
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_secret

# Required for Gemini-powered documentation generation
GEMINI_API_KEY=replace_with_gemini_api_key
DOCUMENTATION_MODEL=gemini-3.1-flash-lite-preview
CHAT_MODEL=gemini-3.1-flash-lite-preview
GEMINI_THINKING_LEVEL=high
GEMINI_API_VERSION=v1alpha
DOCUMENTATION_CONTEXT_CHAR_LIMIT=36000

# Vector store backend:
# - production on Render: pinecone
# - local development: chroma
# - no external vector service: local
VECTOR_BACKEND=pinecone
EMBEDDING_MODEL=gemini-embedding-001
PINECONE_API_KEY=replace_with_pinecone_api_key
PINECONE_INDEX_NAME=archimind
PINECONE_HOST=https://your-index-host.pinecone.io
PINECONE_NAMESPACE=prod
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Keep this aligned with your Pinecone index. The current archimind index uses 1024.
PINECONE_DIMENSION=1024

# Database URL
# Local development via scripts/run_local.sh uses SQLite automatically unless
# you explicitly opt into the remote database with:
# ARCHIMIND_USE_REMOTE_DB=1 bash scripts/run_local.sh
#
# Render / Supabase PostgreSQL:
# - copy the full connection string from Supabase -> Connect -> Transaction pooler
# - URL-encode special password characters such as @ -> %40
# - Render must receive the full URL, not a masked token or partial value
# Example:
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres
# Local development fallback:
# DATABASE_URL=sqlite:///data/archimind_dev.db
DATABASE_URL=sqlite:///data/archimind_dev.db

# Optional Flask runtime options
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
# Render injects PORT for Gunicorn. FLASK_PORT is only used for direct local app.py runs.
FLASK_PORT=5000
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
PREFERRED_URL_SCHEME=https

# Optional anonymous usage cap
ANONYMOUS_GENERATION_LIMIT=5
REQUEST_TIMEOUT_SECONDS=25
REMOTE_FETCH_MAX_FILES=120
REMOTE_FETCH_CONCURRENCY=8
REMOTE_FILE_MAX_BYTES=220000

# Optional Google OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recommended Render production envs beyond the three secrets above:
# VECTOR_BACKEND=pinecone
# PINECONE_INDEX_NAME=archimind
# PINECONE_HOST=https://your-index-host.pinecone.io
# PINECONE_NAMESPACE=prod
# SESSION_COOKIE_SECURE=1
# PREFERRED_URL_SCHEME=https

# Optional Docker / deployment defaults
ARCHIMIND_IMAGE=krishnah27/archimind:latest
DOCKERHUB_REPO=krishnah27/archimind
DOCKER_IMAGE_TAG=latest
PI_USER=pi
PI_HOST=192.168.0.65
PI_DIR=/home/pi/archimind

# Local HTTP OAuth testing only. Use 0 in production over HTTPS.
OAUTHLIB_INSECURE_TRANSPORT=0
